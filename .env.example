# Copy this file to .env.local and fill in real values. Never put real keys in this file.

# --- Supabase (Project Settings -> API Keys; the URL is under Connect / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# --- AI (free: Google Gemini via https://aistudio.google.com/apikey, no card needed) ---
AI_API_KEY=
# Optional. Defaults shown. Any OpenAI-compatible endpoint works (Groq, OpenRouter, ...).
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.5-flash-lite

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Reminder job ---
# Any long random string. The scheduler sends it as "Authorization: Bearer <secret>".
CRON_SECRET=

# --- Public site URL (your deployed URL in production) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI usage caps per day (per signed-in user / per anonymous demo visitor) ---
AI_DAILY_LIMIT_USER=100
AI_DAILY_LIMIT_DEMO=8
